{
  "permissions": {
    "allow": [
      "Bash(git *)",
      "Bash(git * && *)",
      "Bash(git status && git log *)",
      "Bash(git status && git log origin/$(git branch --show-current)..HEAD 2>/dev/null || echo \"No upstream branch\")",
      "Bash(git -C * worktree *)",
      "Bash(WORKTREE=* && MAIN=* && git -C * worktree *)",
      "Bash(gh *)",
      "Bash(flutter *)",
      "Bash(flutter analyze)",
      "Bash(flutter test*)",
      "Bash(flutter run*)",
      "Bash(flutter pub *)",
      "Bash(dart *)",
      "Bash(*/flutter/bin/flutter *)",
      "Bash(*/flutter/bin/flutter analyze)",
      "Bash(*/flutter/bin/flutter test*)",
      "Bash(*/flutter/bin/flutter run*)",
      "Bash(*/flutter/bin/flutter pub *)",
      "Bash(*/flutter/bin/dart *)",
      "Bash(source ~/.zshrc)",
      "Bash(echo *)",
      "Bash(grep *)",
      "Bash(find *)",
      "Bash(mkdir *)",
      "Bash(tee /tmp/*)",
      "Bash(cat *)",
      "Bash(ls *)",
      "Bash(python3 *)",
      "Bash(bash scripts/coverage.sh)",
      "Bash(osascript *)",
      "mcp__linear__*",
      "mcp__github__*",
      "mcp__supabase__list_tables",
      "mcp__supabase__list_migrations",
      "mcp__supabase__list_branches",
      "mcp__supabase__list_extensions",
      "mcp__supabase__list_edge_functions",
      "mcp__supabase__get_advisors",
      "mcp__supabase__get_edge_function",
      "mcp__supabase__get_logs",
      "mcp__supabase__get_project_url",
      "mcp__supabase__get_publishable_keys",
      "mcp__supabase__search_docs",
      "mcp__supabase__generate_typescript_types",
      "Read(*)",
      "Write(**)",
      "Edit(lib/**)",
      "Edit(test/**)",
      "Edit(scripts/**)",
      "Edit(skills/**)",
      "Edit(.claude/**)",
      "Edit(android/app/src/**)",
      "Edit(ios/Runner/**)",
      "Edit(macos/Runner/**)",
      "Edit(web/**)",
      "WebSearch(*)",
      "WebFetch(*)"
    ],
    "deny": [
      "Write(build/**)",
      "Write(.dart_tool/**)",
      "Write(.pub-cache/**)",
      "Write(.pub/**)",
      "Write(node_modules/**)",
      "Write(.idea/**)",
      "Write(.build/**)",
      "Write(.buildlog/**)",
      "Write(venv/**)",
      "Write(**/*.log)",
      "Write(**/.DS_Store)",
      "Write(.env)",
      "Write(macos/Flutter/GeneratedPluginRegistrant.swift)",
      "Write(ios/Flutter/GeneratedPluginRegistrant.*)",
      "Edit(build/**)",
      "Edit(.dart_tool/**)",
      "Edit(.pub-cache/**)",
      "Edit(.pub/**)",
      "Edit(node_modules/**)",
      "Edit(.idea/**)",
      "Edit(.env)",
      "Edit(macos/Flutter/GeneratedPluginRegistrant.swift)",
      "Edit(ios/Flutter/GeneratedPluginRegistrant.*)"
    ]
  },
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "jq -r '.tool_input.command' | grep -q 'build_runner' && python3 scripts/fix_mock_ignores.py || true",
            "statusMessage": "Fixing duplicate ignores in mock files…"
          }
        ]
      }
    ]
  },
  "enableAllProjectMcpServers": true,
  "enabledMcpjsonServers": [
    "github",
    "supabase",
    "linear"
  ]
}
