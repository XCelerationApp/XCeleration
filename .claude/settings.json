{
  "permissions": {
    "allow": [
      "Bash(git *)",
      "Bash(git * && *)",
      "Bash(git status && git log *)",
      "Bash(git status && git log origin/$(git branch --show-current)..HEAD 2>/dev/null || echo \"No upstream branch\")",
      "Bash(git -C * worktree *)",
      "Bash(WORKTREE=* && MAIN=* && git -C * worktree *)",
      "Bash(gh *)",
      "Bash(flutter *)",
      "Bash(flutter analyze)",
      "Bash(flutter test*)",
      "Bash(flutter run*)",
      "Bash(flutter pub *)",
      "Bash(dart *)",
      "Bash(*/flutter/bin/flutter *)",
      "Bash(*/flutter/bin/flutter analyze)",
      "Bash(*/flutter/bin/flutter test*)",
      "Bash(*/flutter/bin/flutter run*)",
      "Bash(*/flutter/bin/flutter pub *)",
      "Bash(*/flutter/bin/dart *)",
      "Bash(source ~/.zshrc)",
      "Bash(echo *)",
      "Bash(grep *)",
      "Bash(find *)",
      "Bash(mkdir *)",
      "Bash(tee /tmp/*)",
      "Bash(cat *)",
      "Bash(ls *)",
      "Bash(python3 *)",
      "Bash(bash scripts/coverage.sh)",
      "Bash(osascript *)",
      "mcp__linear__*",
      "mcp__github__*",
      "Read(*)",
      "Write(**)",
      "Edit(lib/**)",
      "Edit(test/**)",
      "Edit(scripts/**)",
      "Edit(skills/**)",
      "Edit(.claude/**)",
      "Edit(android/app/src/**)",
      "Edit(ios/Runner/**)",
      "Edit(macos/Runner/**)",
      "Edit(web/**)"
    ],
    "deny": [
      "Write(build/**)",
      "Write(.dart_tool/**)",
      "Write(.pub-cache/**)",
      "Write(.pub/**)",
      "Write(node_modules/**)",
      "Write(.idea/**)",
      "Write(.build/**)",
      "Write(.buildlog/**)",
      "Write(venv/**)",
      "Write(**/*.log)",
      "Write(**/.DS_Store)",
      "Write(.env)",
      "Write(macos/Flutter/GeneratedPluginRegistrant.swift)",
      "Write(ios/Flutter/GeneratedPluginRegistrant.*)",
      "Edit(build/**)",
      "Edit(.dart_tool/**)",
      "Edit(.pub-cache/**)",
      "Edit(.pub/**)",
      "Edit(node_modules/**)",
      "Edit(.idea/**)",
      "Edit(.env)",
      "Edit(macos/Flutter/GeneratedPluginRegistrant.swift)",
      "Edit(ios/Flutter/GeneratedPluginRegistrant.*)"
    ]
  },
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "INPUT=$(cat); CMD=$(echo \"$INPUT\" | jq -r '.tool_input.command // \"\"'); if echo \"$CMD\" | grep -q 'build_runner'; then MATCHES=$(grep -rln '// ignore:' test/ --include='*.mocks.dart' 2>/dev/null); if [ -n \"$MATCHES\" ]; then FILES=$(echo \"$MATCHES\" | tr '\\n' ' '); jq -n --arg m \"WARNING: duplicate_ignore in mocks — remove per-line // ignore: that duplicate // ignore_for_file: in: $FILES\" '{systemMessage: $m}'; fi; fi",
            "timeout": 10,
            "statusMessage": "Checking mocks for duplicate ignores..."
          }
        ]
      }
    ]
  },
  "enableAllProjectMcpServers": true,
  "enabledMcpjsonServers": [
    "github",
    "supabase",
    "linear"
  ]
}
